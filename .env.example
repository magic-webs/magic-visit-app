EXPO_PUBLIC_INSTANT_APP_ID=
INSTANT_APP_ADMIN_TOKEN=

# Auth-bridge Worker base URL (see auth-bridge/). For local dev via `wrangler
# dev`: iOS simulator/web can use http://localhost:8787; Android emulator
# needs http://10.0.2.2:8787; a physical device needs your machine's LAN IP.
EXPO_PUBLIC_AUTH_BRIDGE_URL=http://localhost:8787

# The auth-bridge is now multi-tenant — every build is scoped to one
# business via its slug. This build ships as the migrated Urmil Jewellers
# tenant; a later phase will replace this with a "find your business"
# picker screen instead of a build-time constant.
EXPO_PUBLIC_TENANT_SLUG=urmil-jewellers

# --- Build-time white-label overrides (see app.config.js) ---
# These affect app.json's old fields (name/slug/scheme/bundle id/icon color)
# and are only read when Expo evaluates the config (expo start, expo
# prebuild, eas build) — never at runtime. Leave unset to build with the
# same values that were hardcoded in the old app.json; set them (e.g. per
# EAS build profile) to produce a differently-branded build from this same
# source tree. Run `npm run sync-tenant-branding` to pull APP_NAME /
# NOTIFICATION_COLOR from this tenant's panel-managed config automatically.
# APP_NAME=Urmil Jewellers
# APP_SLUG=urmil-jewellers-ramnagar
# APP_SCHEME=urmiljewellersramnagar
# IOS_BUNDLE_ID=com.magicwebs.urmiljewellersramnagar
# ANDROID_PACKAGE=com.magicwebs.urmiljewellersramnagar
# NOTIFICATION_COLOR=#097969
# ICON_PATH/ADAPTIVE_ICON_PATH/FAVICON_PATH are also set automatically by
# `npm run sync-tenant-branding` when a tenant has an uploaded icon/logo —
# it downloads it to assets/images/tenant-icon.<ext> (gitignored, a build
# artifact, never commit it) and points all three at that file, since
# Expo's build pipeline needs a real local file, not the remote InstantDB
# $files URL the panel stores. Only set these by hand to override that.
# ICON_PATH=./assets/images/icon.png
# ADAPTIVE_ICON_PATH=./assets/images/adaptive-icon.png
# SPLASH_ICON_PATH=./assets/images/splash-icon.png
# FAVICON_PATH=./assets/images/favicon.png

# Written automatically by `npm run sync-tenant-branding` — a base64 dump of
# this tenant's full theme+branding, inlined into the JS bundle (note the
# EXPO_PUBLIC_ prefix) so the app's first paint already shows the real
# theme instead of the hardcoded default while the runtime fetch is still
# in flight (see contexts/TenantConfigContext.tsx). Never hand-write this.
# EXPO_PUBLIC_BAKED_TENANT_CONFIG=
